# Example configuration for docker compose. Placeholders only - never commit real values.
# Copy to a file kept out of version control (for example fixes.env), fill it in, then run
#   docker compose --env-file fixes.env up -d --build
# Every variable is documented in README.md ("Configuration").

# Required. At least 32 random characters, e.g. the output of
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Left empty on purpose: the server refuses to start until it is set.
FIXES_JWT_SECRET=

# Required. Public URL of the API as phones reach it (used for absolute avatar URLs).
FIXES_PUBLIC_BASE_URL=https://chat.example.org

# MongoDB (the compose stack provides one; point elsewhere for Atlas or your own server).
FIXES_MONGODB_URI=mongodb://mongo:27017
FIXES_MONGODB_DB=fixes

FIXES_LOG_LEVEL=INFO

# Avatar storage: local (served by the API at /media) or s3.
FIXES_STORAGE_BACKEND=local
# Only for FIXES_STORAGE_BACKEND=s3:
FIXES_S3_BUCKET=
FIXES_S3_ENDPOINT_URL=
FIXES_S3_REGION=
FIXES_S3_PUBLIC_BASE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Retention (days).
FIXES_ENVELOPE_TTL_DAYS=30
FIXES_DEVICE_IDLE_DAYS=30

# Comma-separated browser origins allowed by CORS. Empty disables CORS (the mobile app needs none).
FIXES_CORS_ORIGINS=

# Rate limits as <count>/<seconds>. Empty means the protocol default (shown).
FIXES_RATE_LIMIT_REGISTER=5/3600
FIXES_RATE_LIMIT_LOGIN_FAILURES_USER_IP=10/900
FIXES_RATE_LIMIT_LOGIN_FAILURES_IP=50/3600
# Successful password checks (logins, password changes, identity resets) per account.
FIXES_RATE_LIMIT_LOGIN_SUCCESS=30/3600
FIXES_RATE_LIMIT_REFRESH=30/3600
FIXES_RATE_LIMIT_ENVELOPES=600/60
FIXES_RATE_LIMIT_USER_LOOKUP=60/60
FIXES_RATE_LIMIT_FRIEND_REQUESTS=50/86400
FIXES_RATE_LIMIT_AVATAR=10/3600
FIXES_RATE_LIMIT_WS_CONNECT=20/60
FIXES_WS_MAX_UNAUTHENTICATED_PER_IP=20
# Seconds a new WebSocket may take to send its auth frame before it is closed (4408).
FIXES_WS_AUTH_TIMEOUT_SECONDS=10

# Uvicorn: the only proxy address allowed to set the client IP (Caddy in the tls profile).
FORWARDED_ALLOW_IPS=172.30.0.10

# Compose-level settings.
# Host address:port the API is published on (127.0.0.1:8000 = this machine only).
FIXES_API_PUBLISH=127.0.0.1:8000
# tls profile: the domain Caddy serves and gets a certificate for.
FIXES_DOMAIN=chat.example.org
# s3 profile (MinIO): root credentials (password at least 8 characters) and published S3 port.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
FIXES_MINIO_PUBLISH=127.0.0.1:9000
