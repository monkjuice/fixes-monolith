{
  "expo": {
    "name": "Fixes",
    "slug": "fixes",
    "scheme": "fixes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.fixes.mobile"
    },
    "android": {
      "package": "app.fixes.mobile",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Fixes uses the camera to scan the code shown by a new device you are linking and to take a profile photo.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Fixes needs access to your photos so you can choose a profile photo.",
          "cameraPermission": "Fixes uses the camera to scan the code shown by a new device you are linking and to take a profile photo.",
          "microphonePermission": false
        }
      ],
      "expo-sharing"
    ]
  }
}
