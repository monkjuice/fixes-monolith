# Fixes app configuration — placeholder values only. Never commit real values.
# Expo reads EXPO_PUBLIC_* variables at build/bundle time (from your shell, CI/EAS environment, or a
# local dotenv file you create yourself and keep out of git). See README.md "Configuration".

# Base URL of fixes-server, without /v1 (the app appends /v1/... and derives wss://.../v1/ws).
# Release builds refuse anything but https; development builds also accept http (e.g. an emulator
# talking to a local server at http://10.0.2.2:8000).
EXPO_PUBLIC_API_URL=https://fixes.example.com

# Only for `npm run test:e2e`: the server the end-to-end suite talks to.
FIXES_E2E_API_URL=http://127.0.0.1:8000
